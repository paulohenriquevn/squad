{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment_": "Copy this file to settings.local.json (gitignored) and tweak. Personal-only overrides go here. NEVER commit settings.local.json. The values below are illustrative defaults — keep, edit, or delete each key freely. Do NOT redeclare permissions already in settings.json (curl/wget/npm/etc) — they merge additively.",
  "model": "claude-opus-4-7",
  "permissions": {
    "allow": [
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh issue view *)",
      "Bash(gh run view *)"
    ],
    "ask": [
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh release create *)"
    ]
  },
  "env": {
    "CLAUDE_DEBUG_HOOKS": "0"
  }
}
