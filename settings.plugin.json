{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_DEBUG_HOOKS": "0"
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$CLAUDE_PROJECT_DIR/mechanisms/fleet/statusline.sh\""
  },
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit(*)",
      "Bash(*)",
      "Bash(ls *)",
      "Bash(tree *)",
      "Bash(wc *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(find *)",
      "Bash(cat *)",
      "Bash(mkdir *)",
      "Bash(mv *)",
      "Bash(cp *)",
      "Bash(rm *)",
      "Bash(jq *)",
      "Bash(yq *)",
      "Bash(ast-grep *)",
      "Bash(sg *)",
      "Bash(python3 *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git stash *)",
      "Bash(git add *)",
      "Bash(git restore --staged *)",
      "Bash(git show *)",
      "Bash(git remote -v)",
      "Bash(git ls-files *)",
      "Bash(git switch *)"
    ],
    "ask": [],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf $HOME)",
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Bash(git checkout *)",
      "Bash(git revert *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git rebase -i *)",
      "Edit(study-material/**)",
      "Read(.env)",
      "Edit(.env)",
      "Read(**/.env)",
      "Edit(**/.env)",
      "Read(**/*.pem)",
      "Edit(**/*.pem)",
      "Read(**/*.key)",
      "Edit(**/*.key)",
      "Read(**/*.p12)",
      "Edit(**/*.p12)",
      "Read(**/*.pfx)",
      "Edit(**/*.pfx)",
      "Read(**/*.jks)",
      "Edit(**/*.jks)",
      "Read(**/*.keystore)",
      "Edit(**/*.keystore)",
      "Read(**/id_rsa)",
      "Edit(**/id_rsa)",
      "Read(**/id_dsa)",
      "Edit(**/id_dsa)",
      "Read(**/id_ecdsa)",
      "Edit(**/id_ecdsa)",
      "Read(**/id_ed25519)",
      "Edit(**/id_ed25519)",
      "Read(**/.netrc)",
      "Edit(**/.netrc)",
      "Read(**/.pgpass)",
      "Edit(**/.pgpass)",
      "Read(**/.npmrc)",
      "Edit(**/.npmrc)",
      "Read(**/.pypirc)",
      "Edit(**/.pypirc)",
      "Read(**/credentials)",
      "Edit(**/credentials)",
      "Read(**/credentials.json)",
      "Edit(**/credentials.json)",
      "Read(**/service-account*.json)",
      "Edit(**/service-account*.json)",
      "Read(**/kubeconfig)",
      "Edit(**/kubeconfig)",
      "Read(**/*.kubeconfig)",
      "Edit(**/*.kubeconfig)",
      "Read(**/secret.yaml)",
      "Edit(**/secret.yaml)",
      "Read(**/secret.yml)",
      "Edit(**/secret.yml)",
      "Read(**/secrets.yaml)",
      "Edit(**/secrets.yaml)",
      "Read(**/secrets.yml)",
      "Edit(**/secrets.yml)",
      "Read(**/*-secret.yaml)",
      "Edit(**/*-secret.yaml)",
      "Read(**/*-secret.yml)",
      "Edit(**/*-secret.yml)",
      "Read(**/*-secrets.yaml)",
      "Edit(**/*-secrets.yaml)",
      "Read(**/*-secrets.yml)",
      "Edit(**/*-secrets.yml)",
      "Read(**/*.secrets.env)",
      "Edit(**/*.secrets.env)",
      "Read(.env.local)",
      "Edit(.env.local)",
      "Read(.env.dev)",
      "Edit(.env.dev)",
      "Read(.env.development)",
      "Edit(.env.development)",
      "Read(.env.test)",
      "Edit(.env.test)",
      "Read(.env.staging)",
      "Edit(.env.staging)",
      "Read(.env.prod)",
      "Edit(.env.prod)",
      "Read(.env.production)",
      "Edit(.env.production)",
      "Read(.env.secret)",
      "Edit(.env.secret)",
      "Read(.env.secrets)",
      "Edit(.env.secrets)",
      "Read(**/.env.local)",
      "Edit(**/.env.local)",
      "Read(**/.env.dev)",
      "Edit(**/.env.dev)",
      "Read(**/.env.development)",
      "Edit(**/.env.development)",
      "Read(**/.env.test)",
      "Edit(**/.env.test)",
      "Read(**/.env.staging)",
      "Edit(**/.env.staging)",
      "Read(**/.env.prod)",
      "Edit(**/.env.prod)",
      "Read(**/.env.production)",
      "Edit(**/.env.production)",
      "Read(**/.env.secret)",
      "Edit(**/.env.secret)",
      "Read(**/.env.secrets)",
      "Edit(**/.env.secrets)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/sessionstart-context.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/userpromptsubmit-inject.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/validate-command.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/boundary-check.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit-check.py\"",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/public-copy-lint.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/english-only-check.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-validation.py\"",
            "timeout": 120
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/precompact-preserve.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "skipDangerousModePermissionPrompt": true,
  "_comment_": "Template for PLUGIN INSTALL layout (consumer project's .claude/ contains the Cycle ecosystem). Used by mechanisms/distribution/install.sh. For standalone use (the Cycle repo itself), see settings.json."
}
